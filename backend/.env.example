# Server configuration
PORT=3000

# Google Auth: the web/backend OAuth client ID. Must equal the server client ID
# the Android app requests ID tokens for.
GOOGLE_BACKEND_CLIENT_ID=your_backend_client_id.apps.googleusercontent.com

# JWT: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=your_jwt_secret_key_here

# Public IP shown on the connection info screen (the VM's static IP in production)
SERVER_PUBLIC_IP=127.0.0.1

# Database (not used by the backend yet; see the mongo service in docker-compose.yml)
# MONGODB_URI=mongodb://localhost:27017/cpen321

# Course pixel stream (optional; this is the default)
# PIXEL_SERVER_URL=wss://8.229.22.124
